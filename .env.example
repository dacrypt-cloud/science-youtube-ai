# ── Science YouTube AI — environment template ──
# Copy to .env and fill in. NEVER commit .env.

# Strict free-only mode (1 = never use paid services, default 1)
FREE_ONLY=1

# ── LLM / AI ──
# Primary free option: Google AI Studio (Gemini 2.5 Flash free tier, no card).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional local LLM (Ollama). If set, used before template fallback.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# ── Stock media (both free with free key; optional — Wikimedia works without keys) ──
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Pipeline defaults ──
DEFAULT_DURATION=12-15
# one of: 8-10, 12-15, 15-20, auto
DEFAULT_VOICE=edge
# edge | gtts | piper | espeak | silent
EDGE_VOICE=en-US-AvaNeural
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# ── YouTube upload (optional) ──
# OAuth client for YouTube Data API v3. Upload never blocks production.
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_FILE=token.json

# ── Paths ──
PROJECTS_DIR=projects
CACHE_DIR=.cache/sy_ai
